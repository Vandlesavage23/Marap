# Copy to terraform.tfvars (git-ignored if it holds anything environment specific). NO SECRETS HERE.
domain            = "dev.marriageconnect.example" # replace with the real domain
certificate_arn   = "arn:aws:acm:af-south-1:000000000000:certificate/replace-me"
github_repository = "ORG/marriage-connect"
admin_ip_allowlist = [] # e.g. ["203.0.113.10/32"]; REQUIRED (non-empty) in staging and prod

